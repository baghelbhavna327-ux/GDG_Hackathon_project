# HealthChain AI - Environment Variables Example Template
# Duplicate this file to .env and configure local connection URLs

# Node.js Express Backend Port
PORT=5000

# MongoDB Connection String (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/healthchain-ai

# React Frontend Origin for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# FastAPI AI Microservice URL
FASTAPI_URL=http://localhost:8000

# Environment Mode
NODE_ENV=development
